{
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 62008",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 62008",
    "typecheck": "tsc --noEmit",
    "test:engine": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs && node node_modules/.cache/smoke.mjs",
    "test:offline": "esbuild scripts/offline-flow.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/offline.mjs && node node_modules/.cache/offline.mjs",
    "test:render": "esbuild scripts/render.tsx --bundle --platform=node --outfile=node_modules/.cache/render.cjs && node node_modules/.cache/render.cjs",
    "test": "npm run typecheck && npm run test:engine && npm run test:offline && npm run test:render"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
